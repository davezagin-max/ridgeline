{
  "name": "ridgeline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3190",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "smoke": "vitest run tests/kit/smoke.live.test.ts",
    "record": "pnpm record:step --only plan-route && pnpm facts && pnpm record:step --only narrate-route",
    "record:step": "node scripts/record.mjs --port 3190",
    "facts": "UPDATE_FACTS=1 vitest run tests/ai/presets.test.ts -t 'lists every preset'",
    "screenshots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@react-three/fiber": "^9.8.1",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.24.0"
}
